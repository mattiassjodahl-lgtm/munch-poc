---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getGlobal, themes, type Theme } from '../lib/strapi';

interface Props {
  title?: string;
  description?: string;
  /** Färgtema för header + sida (detaljsidor). Utelämnat = svart header. */
  theme?: Theme;
}
const { title, description, theme } = Astro.props;
let global: any = null;
try { global = await getGlobal(); } catch (e) { console.error(e); }

const t = theme ? themes[theme] : null;
const pageStyle = t ? `--theme-bg:${t.bg};--theme-fg:${t.fg};` : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title ? `${title} – MUNCH (prototype)` : 'MUNCH (prototype)'}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />
  </head>
  <body class={t ? 'themed' : ''} style={pageStyle}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:p-2">Skip to content</a>
    <Header global={global} themed={!!t} />
    <main id="main">
      <slot />
    </main>
    <Footer global={global} />
    <div class="fixed bottom-3 left-3 z-40 rounded-full bg-black/80 px-3 py-1 text-xs text-white">Prototype · Consid</div>
  </body>
</html>
