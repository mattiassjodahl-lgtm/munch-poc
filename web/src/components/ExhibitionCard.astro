---
import { mediaUrl, themeStyle, type Exhibition } from '../lib/strapi';
interface Props { exhibition: Exhibition; class?: string }
const { exhibition: e, class: cls } = Astro.props;
---
<a href={`/en/exhibitions/${e.slug}`}
   class:list={['themed group flex flex-col p-5 transition-transform duration-300 hover:-translate-y-1', cls]}
   style={themeStyle(e.theme)}>
  <div class="aspect-[239/250] overflow-hidden">
    <img src={mediaUrl(e.image, e.imageUrl)} alt="" loading="lazy"
         class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
  </div>
  <h3 class="display mt-5 text-[28px] md:text-[32px]">
    <span class="block">{e.kicker}</span>
    <span class="backslant">{e.title}</span>
  </h3>
  <p class="mt-3 text-base leading-snug">{e.teaser}</p>
  <div class="mt-auto flex justify-between gap-2 pt-6 text-sm">
    <span>{e.dateLabel}</span>
    <span>{e.floor}</span>
  </div>
</a>
