---
import { formatEventDate, mediaUrl, type EventItem } from '../../lib/strapi';
interface Props { section: any; events: EventItem[] }
const { section, events } = Astro.props;
---
<section class="px-4 py-16 md:px-8 md:py-24">
  <h2 class="display text-[48px] md:text-[68px]">{section.title}</h2>
  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {events.map((e) => (
      <a href="#" class="group block">
        <div class="aspect-[4/3] overflow-hidden bg-line">
          <img src={mediaUrl(e.image, e.imageUrl)} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
        </div>
        <p class="mt-3 text-sm">{e.category}</p>
        <h3 class="display mt-1 text-[28px]">{e.title}</h3>
        <p class="mt-1 text-base">{formatEventDate(e.startsAt)}</p>
      </a>
    ))}
  </div>
</section>
