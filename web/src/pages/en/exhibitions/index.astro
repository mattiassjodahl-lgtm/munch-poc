---
import Base from '../../../layouts/Base.astro';
import ExhibitionCard from '../../../components/ExhibitionCard.astro';
import { getExhibitions } from '../../../lib/strapi';

const all = await getExhibitions();
const current = all.filter((e) => !e.isCollection);
const collection = all.filter((e) => e.isCollection);
Astro.response.headers.set('Cache-Control', 's-maxage=30, stale-while-revalidate=300');
---
<Base title="Exhibitions">
  <section class="px-4 pt-12 md:px-8 md:pt-20">
    <h1 class="display text-[64px] md:text-[120px]">WHAT’S ON</h1>
    <div class="mt-8 flex gap-8 border-b border-black text-lg" role="tablist">
      <a href="/en/exhibitions" role="tab" aria-selected="true" class="-mb-px border-b-4 border-black pb-3 font-bold">Exhibitions</a>
      <a href="#" role="tab" aria-selected="false" class="pb-3">Events</a>
    </div>
  </section>

  <section class="px-4 py-14 md:px-8">
    <h2 class="display text-[40px] md:text-[56px]">CURRENT EXHIBITIONS</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {current.map((e) => <ExhibitionCard exhibition={e} class="min-h-[530px]" />)}
    </div>
  </section>

  <section class="px-4 pb-24 md:px-8">
    <h2 class="display text-[40px] md:text-[56px]">COLLECTION EXHIBITIONS</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {collection.map((e) => <ExhibitionCard exhibition={e} class="min-h-[530px]" />)}
    </div>
  </section>
</Base>
